{
	"name": "TicTacTest DevContainer",
	// Lokale Entwicklung nutzt automatisch das neueste freigegebene Image
	// aus der GitHub Container Registry (statt lokal aus dem Dockerfile zu bauen).
	// Der Image-Name muss beim tatsächlichen GHCR-Pfad kleingeschrieben sein.
	"image": "ghcr.io/timeo2342/450-tictactest-mvk-devcontainer:v1.0.6",
	// Run as the non-root user created in the Dockerfile (UID:GID 1000:1000).
	"remoteUser": "dev",
	"workspaceFolder": "/workspace",
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"vscjava.vscode-gradle",
				"redhat.java",
				"vscjava.vscode-java-debug",
				"vscjava.vscode-java-test"
			],
			"settings": {
				"java.jdt.ls.java.home": "/opt/java/openjdk",
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	// Make the Gradle wrapper executable after the container is created.
	"postCreateCommand": "chmod +x gradlew",
	"remoteEnv": {
		"JAVA_HOME": "/opt/java/openjdk"
	}
}
